<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0a0a0f">
<title>Для Раи</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;700&display=swap');

:root{
  --bg:#0a0a0f;
  --bg-2:#12121a;
  --ink:#e8e6e3;
  --muted:#7a7a85;
  --accent:#c1121f;
  --accent-2:#8b0000;
  --gold:#d4af37;
  --purple:#6b2d8f;
}

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow-x:hidden}
body{
  font-family:'JetBrains Mono',monospace;
  background:var(--bg);
  color:var(--ink);
  min-height:100dvh;
  position:relative;
  overflow-x:hidden;
}

/* Зерно / шум */
body::before{
  content:'';
  position:fixed;
  inset:0;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(107,45,143,.15), transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(193,18,31,.12), transparent 50%);
  pointer-events:none;
  z-index:0;
}
body::after{
  content:'';
  position:fixed;
  inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.12'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:1;
  opacity:.5;
  mix-blend-mode:overlay;
}

/* Виньетка */
.vignette{
  position:fixed;
  inset:0;
  background:radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.85) 100%);
  pointer-events:none;
  z-index:2;
}

.stage{
  position:relative;
  z-index:3;
  min-height:100dvh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:32px 22px 48px;
  gap:24px;
}

/* Экран */
.screen{
  display:none;
  width:100%;
  max-width:440px;
  animation:fadeUp .7s cubic-bezier(.2,.7,.3,1);
}
.screen.active{display:block}

@keyframes fadeUp{
  from{opacity:0;transform:translateY(24px)}
  to{opacity:1;transform:translateY(0)}
}

/* Прогресс */
.progress{
  display:flex;
  gap:8px;
  justify-content:center;
  margin-bottom:32px;
}
.dot{
  width:6px;height:6px;
  border-radius:50%;
  background:rgba(255,255,255,.15);
  transition:all .4s ease;
}
.dot.on{
  background:var(--accent);
  box-shadow:0 0 12px var(--accent);
  transform:scale(1.3);
}

/* Заголовки */
.kicker{
  font-family:'JetBrains Mono',monospace;
  font-size:10px;
  letter-spacing:.4em;
  text-transform:uppercase;
  color:var(--muted);
  text-align:center;
  margin-bottom:14px;
}
.kicker span{color:var(--accent)}

h1{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(44px, 14vw, 68px);
  line-height:.92;
  letter-spacing:.02em;
  text-align:center;
  margin-bottom:20px;
  text-shadow:0 0 40px rgba(193,18,31,.35);
}
h1 em{
  font-style:normal;
  color:var(--accent);
  display:block;
}

h2{
  font-family:'Cormorant Garamond',serif;
  font-size:26px;
  font-weight:600;
  line-height:1.25;
  text-align:center;
  margin-bottom:16px;
  letter-spacing:.01em;
}

p{
  font-family:'Cormorant Garamond',serif;
  font-size:18px;
  line-height:1.55;
  color:#c8c5bf;
  text-align:center;
  margin-bottom:14px;
}
p.mono{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  letter-spacing:.06em;
  color:var(--muted);
  line-height:1.7;
}

/* Крест-разделитель */
.cross-div{
  display:flex;
  align-items:center;
  gap:14px;
  justify-content:center;
  margin:24px 0;
  color:var(--accent);
}
.cross-div::before,.cross-div::after{
  content:'';
  height:1px;
  flex:1;
  max-width:80px;
  background:linear-gradient(90deg, transparent, var(--accent), transparent);
}
.cross-div .x{
  font-size:20px;
  text-shadow:0 0 16px var(--accent);
  animation:pulse 3s ease-in-out infinite;
}
@keyframes pulse{
  0%,100%{opacity:.7}
  50%{opacity:1}
}

/* Карточки-выборы */
.choices{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:28px;
}
.choice{
  background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  padding:18px 20px;
  color:var(--ink);
  font-family:'Cormorant Garamond',serif;
  font-size:18px;
  text-align:left;
  cursor:pointer;
  transition:all .25s ease;
  display:flex;
  align-items:center;
  gap:14px;
  position:relative;
  overflow:hidden;
}
.choice::before{
  content:'';
  position:absolute;
  left:0;top:0;bottom:0;
  width:3px;
  background:var(--accent);
  transform:scaleY(0);
  transform-origin:center;
  transition:transform .3s ease;
}
.choice:active{
  transform:scale(.98);
  border-color:rgba(193,18,31,.5);
  background:linear-gradient(180deg, rgba(193,18,31,.08), rgba(193,18,31,.02));
}
.choice:active::before{transform:scaleY(1)}
.choice .num{
  font-family:'Bebas Neue',sans-serif;
  font-size:22px;
  color:var(--accent);
  width:26px;
  flex-shrink:0;
  letter-spacing:.05em;
}
.choice .txt{flex:1;line-height:1.3}
.choice .txt small{
  display:block;
  font-family:'JetBrains Mono',monospace;
  font-size:10px;
  letter-spacing:.15em;
  text-transform:uppercase;
  color:var(--muted);
  margin-top:4px;
}

/* Кнопки */
.btn{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  width:100%;
  padding:18px 24px;
  background:var(--accent);
  color:#fff;
  border:none;
  border-radius:14px;
  font-family:'Bebas Neue',sans-serif;
  font-size:20px;
  letter-spacing:.12em;
  cursor:pointer;
  margin-top:24px;
  transition:all .25s ease;
  box-shadow:0 8px 28px rgba(193,18,31,.3);
  position:relative;
  overflow:hidden;
}
.btn:active{
  transform:scale(.97);
  box-shadow:0 4px 16px rgba(193,18,31,.5);
}
.btn.ghost{
  background:transparent;
  border:1px solid rgba(255,255,255,.15);
  color:var(--ink);
  box-shadow:none;
}

/* Карточки-сообщения */
.card{
  background:linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01));
  border:1px solid rgba(255,255,255,.08);
  border-radius:18px;
  padding:26px 22px;
  margin-top:12px;
  position:relative;
}
.card::before{
  content:'✝';
  position:absolute;
  top:-10px;left:50%;
  transform:translateX(-50%);
  background:var(--bg);
  padding:0 12px;
  color:var(--accent);
  font-size:16px;
  text-shadow:0 0 12px var(--accent);
}

/* Цитата */
.quote{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  font-size:22px;
  line-height:1.4;
  color:var(--gold);
  text-align:center;
  padding:8px 0;
  border-left:2px solid var(--gold);
  border-right:2px solid var(--gold);
  padding:18px 20px;
  margin:20px 0;
  opacity:0;
  animation:quoteIn 1s .4s ease forwards;
}
@keyframes quoteIn{
  from{opacity:0;letter-spacing:.3em}
  to{opacity:1;letter-spacing:.01em}
}

/* Кассетный/винил проигрыватель */
.player{
  margin:24px auto 8px;
  width:180px;
  height:180px;
  border-radius:50%;
  background:
    radial-gradient(circle at center, #1a1a1a 0 22%, transparent 23%),
    repeating-radial-gradient(circle at center, #0d0d0d 0 3px, #141414 3px 4px);
  border:2px solid rgba(255,255,255,.06);
  position:relative;
  box-shadow:
    inset 0 0 40px rgba(0,0,0,.9),
    0 10px 40px rgba(0,0,0,.6);
}
.player.spin{
  animation:spin 6s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.player::after{
  content:'';
  position:absolute;
  inset:32%;
  border-radius:50%;
  background:linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow:0 0 30px rgba(193,18,31,.5);
}
.player::before{
  content:'✝';
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  color:rgba(255,255,255,.9);
  font-size:20px;
  z-index:2;
}

/* Тонкие крестики на фоне */
.crosses{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:1;
  opacity:.15;
  font-size:12px;
  color:var(--accent);
}
.crosses span{
  position:absolute;
  animation:float 8s ease-in-out infinite;
}
@keyframes float{
  0%,100%{opacity:.2;transform:translateY(0)}
  50%{opacity:.6;transform:translateY(-8px)}
}

/* Финальный экран */
.final{
  text-align:center;
  padding:16px 0;
}
.final .huge{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(56px, 18vw, 96px);
  line-height:.9;
  letter-spacing:.02em;
  background:linear-gradient(180deg, #fff 30%, var(--accent) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  -webkit-text-fill-color:transparent;
  text-shadow:0 0 60px rgba(193,18,31,.4);
  margin-bottom:20px;
  animation:shine 3s ease-in-out infinite;
}
@keyframes shine{
  0%,100%{filter:brightness(1)}
  50%{filter:brightness(1.25)}
}

.tag{
  display:inline-block;
  padding:6px 14px;
  border:1px solid rgba(193,18,31,.4);
  border-radius:100px;
  font-family:'JetBrains Mono',monospace;
  font-size:10px;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:var(--accent);
  margin:8px 4px;
}

.hearts{
  font-size:14px;
  letter-spacing:.6em;
  color:var(--accent);
  margin:20px 0;
  text-shadow:0 0 12px var(--accent);
}

.sign{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  font-size:16px;
  color:var(--muted);
  margin-top:28px;
}

/* Мелкие детали */
.hint{
  font-family:'JetBrains Mono',monospace;
  font-size:10px;
  letter-spacing:.2em;
  color:var(--muted);
  text-align:center;
  margin-top:20px;
  opacity:.6;
}

/* Scroll не мешает */
::-webkit-scrollbar{width:0;height:0}
</style>
</head>
<body>

<div class="vignette"></div>

<!-- Плавающие крестики -->
<div class="crosses" id="crosses"></div>

<div class="stage">

  <!-- ============ ЭКРАН 0: Приветствие ============ -->
  <section class="screen active" data-screen="0">
    <div class="progress">
      <div class="dot on"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div>
    </div>

    <div class="kicker">персонально · для одной</div>
    <h1>Р А Я<em>.</em></h1>

    <div class="cross-div"><span class="x">✝</span></div>

    <p class="mono">это не письмо. это не терапия.<br>это просто небольшой интерактив,<br>чтобы вечер стал немного легче.</p>

    <button class="btn" onclick="go(1)">начать ⟶</button>
    <div class="hint">наушники будут кстати</div>
  </section>

  <!-- ============ ЭКРАН 1: Нуар-настрой ============ -->
  <section class="screen" data-screen="1">
    <div class="progress">
      <div class="dot"></div><div class="dot on"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div>
    </div>

    <div class="kicker">глава первая · <span>атмосфера</span></div>
    <h2>Город. Ночь. Дождь.</h2>

    <div class="player" id="vinyl"></div>

    <p>Фонари размазываются по мокрому асфальту.<br>
    Где-то на районе играет бит — низкий, тяжёлый, с этим самым сэмплом из семидесятых.</p>

    <p class="mono">нажми на пластинку — она крутится не просто так</p>

    <div class="choices">
      <button class="choice" onclick="go(2)">
        <span class="num">01</span>
        <span class="txt">включить бит погромче<small>пусть качает</small></span>
      </button>
      <button class="choice" onclick="go(2)">
        <span class="num">02</span>
        <span class="txt">закурить и смотреть в окно<small>без слов</small></span>
      </button>
    </div>
  </section>

  <!-- ============ ЭКРАН 2: Про бывшего ============ -->
  <section class="screen" data-screen="2">
    <div class="progress">
      <div class="dot"></div><div class="dot"></div><div class="dot on"></div><div class="dot"></div><div class="dot"></div>
    </div>

    <div class="kicker">глава вторая · <span>тот самый</span></div>
    <h2>Он был.<br>Ключевое слово — <em style="color:var(--accent);font-style:normal">был</em>.</h2>

    <div class="card">
      <p class="mono" style="text-align:left">он не злодей из фильма.<br>он просто человек, который не подошёл.<br><br>это не про тебя.<br>это про несовпадение.</p>
    </div>

    <div class="cross-div"><span class="x">✝</span></div>

    <p>Люди уходят не потому, что ты недостаточно.<br>А потому, что их маршрут — другой.</p>

    <p class="mono">и это, как ни странно, — хорошая новость.</p>

    <button class="btn" onclick="go(3)">дальше ⟶</button>
  </section>

  <!-- ============ ЭКРАН 3: Манифест ============ -->
  <section class="screen" data-screen="3">
    <div class="progress">
      <div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot on"></div><div class="dot"></div>
    </div>

    <div class="kicker">глава третья · <span>правила</span></div>
    <h2>Три вещи,<br>которые ты должна</h2>

    <div class="choices">
      <button class="choice" onclick="flash(this)">
        <span class="num">I</span>
        <span class="txt">не писать ему<small>особенно в 3 часа ночи</small></span>
      </button>
      <button class="choice" onclick="flash(this)">
        <span class="num">II</span>
        <span class="txt">не проверять его соцсети<small>там всё так же скучно</small></span>
      </button>
      <button class="choice" onclick="flash(this)">
        <span class="num">III</span>
        <span class="txt">не винить себя<small>ты сделала всё, что могла</small></span>
      </button>
    </div>

    <div class="quote">«Сильная — это не та, кто не плачет. Это та, кто плачет и всё равно идёт дальше.»</div>

    <button class="btn" onclick="go(4)">к финалу ⟶</button>
  </section>

  <!-- ============ ЭКРАН 4: Финал ============ -->
  <section class="screen" data-screen="4">
    <div class="progress">
      <div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot on"></div>
    </div>

    <div class="final">
      <div class="kicker">финал · <span>и это только начало</span></div>

      <div class="huge">ХОРОШЕГО<br>ДНЯ.</div>

      <div class="cross-div"><span class="x">✝</span></div>

      <p style="font-size:20px">А он — пусть остаётся в прошлом.<br>Ты туда больше не ходишь.</p>

      <div class="hearts">✝ ✝ ✝</div>

      <div class="card">
        <p class="mono" style="text-align:center;font-size:11px;line-height:1.9">
          новый плейлист<br>
          новая стрижка<br>
          новые люди<br>
          новая ты
        </p>
      </div>

      <div style="margin-top:24px">
        <span class="tag">забыть</span>
        <span class="tag">отпустить</span>
        <span class="tag">жить</span>
      </div>

      <div class="sign">— с уважением, тот кто верит в тебя ✝</div>
    </div>

    <button class="btn ghost" onclick="go(0)" style="margin-top:36px">↺ ещё раз</button>
  </section>

</div>

<script>
/* Плавающие крестики */
(function(){
  const box = document.getElementById('crosses');
  const N = 14;
  for (let i = 0; i < N; i++){
    const s = document.createElement('span');
    s.textContent = Math.random() > .7 ? '✝' : '+';
    s.style.left = Math.random()*100 + '%';
    s.style.top = Math.random()*100 + '%';
    s.style.fontSize = (8 + Math.random()*14) + 'px';
    s.style.animationDelay = (Math.random()*8) + 's';
    s.style.animationDuration = (6 + Math.random()*6) + 's';
    box.appendChild(s);
  }
})();

/* Переключение экранов */
function go(n){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const target = document.querySelector('[data-screen="' + n + '"]');
  if (target){
    target.classList.add('active');
    target.scrollIntoView({behavior:'smooth', block:'start'});
  }
  window.scrollTo({top:0, behavior:'smooth'});
}

/* Пластинка */
const vinyl = document.getElementById('vinyl');
if (vinyl){
  vinyl.addEventListener('click', () => {
    vinyl.classList.toggle('spin');
    if (navigator.vibrate) navigator.vibrate(20);
  });
}

/* Быстрая вспышка на choice */
function flash(el){
  el.style.borderColor = 'var(--accent)';
  el.style.background = 'linear-gradient(180deg, rgba(193,18,31,.15), rgba(193,18,31,.05))';
  setTimeout(() => {
    el.style.borderColor = '';
    el.style.background = '';
  }, 500);
  if (navigator.vibrate) navigator.vibrate(10);
}

/* Свайп влево/вправо для навигации (бонус) */
let touchStartX = 0;
document.addEventListener('touchstart', e => {
  touchStartX = e.changedTouches[0].screenX;
}, {passive:true});
document.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].screenX - touchStartX;
  if (Math.abs(dx) < 80) return;
  const current = document.querySelector('.screen.active');
  if (!current) return;
  const n = parseInt(current.dataset.screen, 10);
  if (dx < 0 && n < 4) go(n + 1);
  if (dx > 0 && n > 0) go(n - 1);
}, {passive:true});

/* Мелкая вибрация при первом касании */
document.addEventListener('touchstart', function once(){
  if (navigator.vibrate) navigator.vibrate(5);
  document.removeEventListener('touchstart', once);
}, {once:true});
</script>

</body>
</html>
